# The bundled Dockerfile still targets java:8 while the dashboard requires JDK 17+,
# so CI builds the image from this file instead.
FROM eclipse-temurin:17-jre

LABEL org.opencontainers.image.source="https://github.com/liuwei1989/rocketmq-dashboard" \
      org.opencontainers.image.description="RocketMQ Dashboard 2.1.0 with the opt-in MIXED message type"

WORKDIR /app
COPY rocketmq-dashboard.jar app.jar

ENV JAVA_OPTS=""
EXPOSE 8082

ENTRYPOINT [ "sh", "-c", "java $JAVA_OPTS -jar /app/app.jar" ]